# ==============================================================================
# RIVA backend — example environment file
#
# Copy to `.env` and fill in real values. Never commit the real `.env`.
# Placeholders below are deliberately empty or non-secret.
# ==============================================================================

# --- Database -------------------------------------------------------------------
# PostgreSQL connection string, e.g.
#   postgresql+psycopg://user:password@localhost/ledgerai
# (Plain postgresql:// and postgres:// URLs are normalised to psycopg v3
# automatically; the server refuses to boot without this variable.)
DATABASE_URL=

# --- JWT authentication ----------------------------------------------------------
# Generate a unique, random value of at least 32 characters. Never commit the
# real value. Useful: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=
# Separate signing key for refresh tokens (>=32 chars). Strongly recommended in
# production so refresh tokens can be rotated independently of access tokens.
# When unset, the server derives a deterministic per-deployment refresh key
# from JWT_SECRET_KEY (still distinct key material, shared across workers).
JWT_REFRESH_SECRET_KEY=
# Access-token lifetime in minutes (server clamps to the 15-30 range).
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
# Refresh-token / session lifetime in days (minimum 1).
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Email delivery (required for email verification / password reset) -----------
# Option 1: SendGrid (recommended for production)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Option 2: Generic SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# SMTP_USE_TLS=true

# Option 3: Development console output — emails are printed to the server log
# instead of being sent. NEVER set this in production.
# DEVELOPMENT=true

# --- Frontend URL ----------------------------------------------------------------
# Frontend base URL for email links (verification/reset). This is the single
# base URL the backend embeds in verification/reset emails. If you run BOTH
# frontends (desktop:3000 and webapp:3001) in production, point this at the
# app whose /verify-email and /reset-password routes the user should land on
# (or set up a redirect on the other host). Keep secrets server-side.
FRONTEND_BASE_URL=http://localhost:3000

# --- Proxy / rate limiting ---------------------------------------------------------
# Trust X-Forwarded-For / X-Real-IP for client-IP rate limiting. Set true ONLY
# when the app is behind a proxy/load balancer that overwrites these headers
# (e.g. Render). Default false = use the direct client IP, which prevents a
# client from rotating a spoofed header to bypass IP-based rate limits.
TRUST_PROXY_HEADERS=false

# --- AI provider (optional — the assistant falls back to a clear error if absent) --
# Any OpenAI-compatible API. Default is OpenAI.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Server (consumed by `python main.py`; production typically runs uvicorn
#     directly and sets its own bind host/port) -------------------------------------
# HOST=0.0.0.0
# PORT=8000
# RELOAD=false

# --- Test database -----------------------------------------------------------------
# Dedicated PostgreSQL database used by the backend test suite ONLY
# (backend/test_support.py). The database name must contain "test" so it can
# never be confused with a development or production database. Tests NEVER
# fall back to DATABASE_URL: if TEST_DATABASE_URL is unset the suite fails
# fast with instructions. Create the database once with `createdb ledgerai_test`.
# Configure it in backend/.env.test (local, gitignored) or as an env var:
# TEST_DATABASE_URL=postgresql+psycopg://localhost/ledgerai_test

# --- SQL logging (debug only — echoing SQL leaks token values into logs) -----------
# SQL_ECHO=false
