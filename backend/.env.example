# PostgreSQL connection string, e.g. postgresql+psycopg://user:password@localhost/ledgerai
DATABASE_URL=
# Generate a unique, random value of at least 32 characters. Never commit the real value.
JWT_SECRET_KEY=
# Separate signing key for refresh tokens (>=32 chars). Strongly recommended in
# production so refresh tokens can be rotated independently of access tokens.
# When unset, the server derives a deterministic per-deployment refresh key
# from JWT_SECRET_KEY (still distinct key material, shared across workers).
JWT_REFRESH_SECRET_KEY=
# Access-token lifetime in minutes (clamped 15-30).
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
# Refresh-token / session lifetime in days (minimum 1).
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Email delivery (required for verification/password reset) ---
# Option 1: SendGrid (recommended for production)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Option 2: Generic SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# SMTP_USE_TLS=true

# Option 3: Development console output (NEVER use in production)
# DEVELOPMENT=true

# Frontend base URL for email links (verification/reset). This is the single
# base URL the backend embeds in verification/reset emails. If you run BOTH
# frontends (desktop:3000 and webapp:3001) in production, point this at the
# app whose /verify-email and /reset-password routes the user should land on
# (or set up a redirect on the other host). Keep secrets server-side.
FRONTEND_BASE_URL=http://localhost:3000

# Trust X-Forwarded-For / X-Real-IP for client-IP rate limiting. Set true ONLY
# when the app is behind a proxy/load balancer that overwrites these headers
# (e.g. Render). Default false = use the direct client IP, which prevents a
# client from rotating a spoofed header to bypass IP-based rate limits.
TRUST_PROXY_HEADERS=false

# --- AI provider (optional — the assistant falls back to a clear error if absent) ---
# Any OpenAI-compatible API. Default is OpenAI.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
