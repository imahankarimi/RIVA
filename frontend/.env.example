# Base URL of the FastAPI backend. No trailing slash.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional canonical public origin for metadata (Open Graph, canonical links).
# Leave unset locally; set to https://theriva.ir in production.
# NEXT_PUBLIC_SITE_URL=https://theriva.ir

# Public URL of the RIVA Web App, used by the cross-site CTA.
# Production: https://app.theriva.ir/
NEXT_PUBLIC_RIVA_WEBAPP_URL=https://app.theriva.ir/
